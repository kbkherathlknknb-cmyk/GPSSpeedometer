<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="500dp"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_location_pin"
            android:tint="@color/speed_cyan"
            android:contentDescription="Log" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRIP HISTORY LOG"
                android:textColor="@color/speed_cyan"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tripLogSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recorded journeys &amp; telemetry data"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/text_muted"
        android:alpha="0.2"
        android:layout_marginBottom="12dp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/emptyLogText"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:text="No completed trips logged yet.\nDrive around and reset a trip to save your stats!"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Scrollable Trip List Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/tripLogItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/text_muted"
        android:alpha="0.2"
        android:layout_marginVertical="12dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnClearLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🗑️ CLEAR ALL"
            android:textColor="@color/speed_orange"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/btn_subtle_background"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnCloseLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CLOSE"
            android:textColor="@color/speed_cyan"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/btn_subtle_background"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
