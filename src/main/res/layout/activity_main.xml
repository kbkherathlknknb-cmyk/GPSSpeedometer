<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- ============ COMPACT STATUS BAR (collapses in PiP/split) ============ -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">

        <View
            android:id="@+id/gpsIndicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/gps_dot_red" />

        <TextView
            android:id="@+id/gpsStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/gps_searching"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/accuracyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnUnitToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KM/H"
            android:textColor="@color/speed_cyan"
            android:textStyle="bold"
            android:textSize="11sp"
            android:background="@drawable/btn_subtle_background"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/text_primary"
            android:background="@drawable/btn_subtle_background"
            android:padding="5dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Menu" />
    </LinearLayout>

    <!-- ============ VIEWPAGER2 (Dashboard + Trip Log) ============ -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ============ SWIPE HINT (bottom) ============ -->
    <TextView
        android:id="@+id/swipeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="◀ SWIPE LEFT FOR TRIP LOG"
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        android:gravity="center"
        android:paddingVertical="3dp" />

</LinearLayout>
