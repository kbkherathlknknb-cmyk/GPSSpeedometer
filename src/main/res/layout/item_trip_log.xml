<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- Top Row: Date & Duration -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tripItemDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📅 Jul 3, 10:30 AM"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tripItemDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱️ 14:22"
            android:textColor="@color/speed_cyan"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_subtle_background"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/text_muted"
        android:alpha="0.15"
        android:layout_marginVertical="8dp" />

    <!-- Middle Row: Big Distance & Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISTANCE DRIVEN"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tripItemDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18.5 km"
                android:textColor="@color/speed_green"
                android:fontFamily="monospace"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Max Speed -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAX SPEED"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tripItemMaxSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="92 km/h"
                android:textColor="@color/speed_orange"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Avg Speed -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVG SPEED"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tripItemAvgSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45 km/h"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
